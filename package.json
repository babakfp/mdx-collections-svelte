{
    "name": "mdx-collections-svelte",
    "version": "2.0.2",
    "description": "An easy way to create collections of markdown pages in SvelteKit.",
    "license": "MIT",
    "repository": "github:babakfp/mdx-collections-svelte",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "rimraf dist && tsc -w",
        "build": "rimraf dist && tsc",
        "prepublishOnly": "rimraf dist && tsc",
        "format": "prettier -w .",
        "test": "vitest --passWithNoTests"
    },
    "peerDependencies": {
        "@sveltejs/kit": "2",
        "mdx-svelte": "4 || 5 || 6",
        "svelte": "5"
    },
    "dependencies": {
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/kit": "^2.68.0",
        "@types/node": "^24.13.2",
        "mdx-svelte": "^6.0.1",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "svelte": "^5.56.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "files": [
        "./dist/"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./zod": "./dist/zod.js"
    },
    "keywords": [
        "svelte",
        "markdown",
        "preprocess",
        "preprocessor",
        "mdx",
        "mdsvex",
        "sveltekit",
        "kit",
        "collections"
    ],
    "type": "module",
    "packageManager": "pnpm@11.9.0"
}
